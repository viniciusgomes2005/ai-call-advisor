LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=

WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=
WHISPER_INITIAL_PROMPT=Advisor, dashboard web, widget flutuante, extensão do Chrome, Google Meet, Teams, MVP.
WHISPER_HOTWORDS=Advisor dashboard web widget flutuante extensão do Chrome Google Meet Teams MVP
WHISPER_VAD_MIN_SILENCE_DURATION_MS=500
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
ASR_USE_DOMAIN_PROMPT=false
ASR_LOAD_ON_STARTUP=true
ASR_WARMUP=false
ASR_PARALLEL_WORKERS=2
ASR_MIN_SPEECH_MS=500
ASR_SILENCE_END_MS=450
ASR_MAX_UTTERANCE_MS=6000
ASR_VAD_RMS_THRESHOLD=0.012
UTTERANCE_ASSEMBLY_ENABLED=true
UTTERANCE_MERGE_MAX_GAP_MS=1200
UTTERANCE_HARD_MAX_DURATION_MS=20000
UTTERANCE_HARD_MAX_CHARS=500
UTTERANCE_FINALIZATION_DELAY_MS=500
UTTERANCE_BACKLOG_WARNING_THRESHOLD=8
ENABLE_STRUCTURED_MEETING_STATE=false

# Visual context (shared screen sampling) - no vision model wired in yet, this only
# builds ScreenFrame/VisualContext capture+storage.
SCREEN_FRAME_SAMPLING_ENABLED=true
SCREEN_FRAME_SAMPLE_INTERVAL_MS=4000
SCREEN_FRAME_FORCE_CAPTURE_INTERVAL_MS=30000
SCREEN_FRAME_CHANGE_THRESHOLD=0.04
SCREEN_FRAME_MAX_DIMENSION=1280
SCREEN_FRAME_JPEG_QUALITY=0.7
VISUAL_CONTEXT_MAX_RECENT=5
SAVE_SCREEN_FRAMES=false

SAVE_RAW_AUDIO=false

LANGUAGE=pt

SILENCE_END_MS=700
MIN_UTTERANCE_MS=700
MAX_UTTERANCE_MS=15000

INTERVENTION_COOLDOWN_SECONDS=10
ENABLE_INTERVENTION_FILTER=true

MAX_LLM_CONCURRENCY=1
MAX_SUGGESTION_AGE_SECONDS=15

CONTEXT_MAX_UTTERANCES=40
CONTEXT_MAX_CHARS=16000

LOG_LEVEL=INFO
